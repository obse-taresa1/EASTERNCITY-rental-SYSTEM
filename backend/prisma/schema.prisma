generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            String                @id @default(uuid())
  name                          String
  email                         String                @unique
  password                      String
  role                          String                @default("USER")
  createdAt                     DateTime              @default(now())
  status                        String                @default("ACTIVE")
  verificationStatus            String                @default("NOT_VERIFIED")
  city                          String?
  sefer                         String?
  address                       String?
  nationalIdFrontUrl            String?
  nationalIdBackUrl             String?
  phone                         String?
  nationalIdNumber              String?
  profileImageUrl               String?
  activityLogs                  ActivityLog[]
  ownedBookings                 Booking[]             @relation("BookingOwner")
  rentedBookings                Booking[]             @relation("BookingRenter")
  communityComments             Comment[]
  communityPosts                CommunityPost[]
  contactMessages               ContactMessage[]
  conversationsAsParticipantOne Conversation[]        @relation("ConversationParticipantOne")
  conversationsAsParticipantTwo Conversation[]        @relation("ConversationParticipantTwo")
  communityLikes                Like[]
  approvedListings              Listing[]             @relation("ListingApprover")
  listings                      Listing[]             @relation("ListingOwner")
  messages                      Message[]             @relation("MessageSender")
  notifications                 Notification[]
  OwnerReply                    OwnerReply[]
  passwordResetTokens           PasswordResetToken[]
  approvedPromotions            Promotion[]           @relation("PromotionApprover")
  promotions                    Promotion[]           @relation("PromotionRequester")
  refreshTokens                 RefreshToken[]
  reports                       Report[]
  reviews                       Review[]
  savedCommunityPosts           SavedPost[]
  supportTickets                SupportTicket[]
  supportTicketReplies          SupportTicketReply[]
  updatedSettings               SystemSetting[]       @relation("SystemSettingUpdater")
  reviewedVerificationRequests  VerificationRequest[] @relation("VerificationReviewer")
  verificationRequests          VerificationRequest[] @relation("VerificationRequester")
}

model VerificationRequest {
  id                 String    @id @default(uuid())
  userId             String
  city               String
  sefer              String
  address            String?
  nationalIdFrontUrl String
  nationalIdBackUrl  String
  status             String    @default("PENDING")
  rejectionReason    String?
  reviewedById       String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  reviewedBy         User?     @relation("VerificationReviewer", fields: [reviewedById], references: [id])
  user               User      @relation("VerificationRequester", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum ListingCondition {
  NEW
  USED
}

model Listing {
  id               String           @id @default(uuid())
  createdAt        DateTime         @default(now())
  title            String
  description      String
  ownerId          String
  categoryId       String?
  city             String
  location         String?
  pricePerDay      Decimal
  priceType        String           @default("Day") // e.g., Hour, Day, Week, Month
  status           String           @default("PENDING")
  condition        ListingCondition? // NEW or USED
  approvedById     String?
  approvedAt       DateTime?
  rejectionReason  String?
  updatedAt        DateTime       @updatedAt
  paymentMethod    String?
  paymentProofUrl  String?
  paymentStatus    String?        @default("PENDING")
  staffRecommended Boolean        @default(false)
  bookings         Booking[]
  conversations    Conversation[]
  approvedBy       User?          @relation("ListingApprover", fields: [approvedById], references: [id])
  category         Category?      @relation(fields: [categoryId], references: [id])
  owner            User           @relation("ListingOwner", fields: [ownerId], references: [id])
  images           ListingImage[]
  matches          Match[]
  promotions       Promotion[]
  reviews          Review[]
  featuredListing  FeaturedListing?

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
}

model Booking {
  id                 String    @id @default(uuid())
  renterId           String
  ownerId            String
  listingId          String
  startDate          DateTime
  endDate            DateTime
  subtotal           Decimal
  serviceFee         Decimal
  totalAmount        Decimal
  agreementAccepted  Boolean   @default(false)
  cancellationReason String?
  approvedAt         DateTime?
  completedAt        DateTime?
  status             String    @default("PENDING")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  listing            Listing   @relation(fields: [listingId], references: [id])
  owner              User      @relation("BookingOwner", fields: [ownerId], references: [id])
  renter             User      @relation("BookingRenter", fields: [renterId], references: [id])
  review             Review?

  @@index([renterId])
  @@index([ownerId])
  @@index([listingId])
  @@index([status])
}

model Conversation {
  id               String         @id @default(uuid())
  participantOneId String
  participantTwoId String
  listingId        String?
  lastMessageAt    DateTime?
  createdAt        DateTime       @default(now())
  communityPostId  Int?
  CommunityPost    CommunityPost? @relation(fields: [communityPostId], references: [id])
  listing          Listing?       @relation(fields: [listingId], references: [id])
  participantOne   User           @relation("ConversationParticipantOne", fields: [participantOneId], references: [id])
  participantTwo   User           @relation("ConversationParticipantTwo", fields: [participantTwoId], references: [id])
  messages         Message[]

  @@unique([participantOneId, participantTwoId, listingId])
  @@index([participantOneId])
  @@index([participantTwoId])
  @@index([listingId])
  @@index([communityPostId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  aiTags    String?
  fileSize  Int?
  height    Int?
  imageHash String?
  mimeType  String?
  width     Int?
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@index([imageHash])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  slug        String    @unique
  listings    Listing[]
}

model Promotion {
  id              String    @id @default(uuid())
  userId          String
  listingId       String
  packageType     String
  placement       String
  amount          Decimal
  paymentType     String
  paymentProofUrl String?
  status          String    @default("PENDING")
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  durationDays    Int?      @default(7)
  endDate         DateTime?
  startDate       DateTime?
  discount        Int?
  customTitle     String?
  customSubtitle  String?
  specs           String?
  approvedBy      User?     @relation("PromotionApprover", fields: [approvedById], references: [id])
  listing         Listing   @relation(fields: [listingId], references: [id])
  user            User      @relation("PromotionRequester", fields: [userId], references: [id])

  @@index([userId])
  @@index([listingId])
  @@index([status])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([listingId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("SystemSettingUpdater", fields: [updatedById], references: [id])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  title         String
  body          String
  type          String
  referenceId   String?
  referenceType String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id         String    @id @default(uuid())
  userId     String?
  name       String
  email      String
  subject    String
  message    String
  status     String    @default("OPEN")
  adminReply String?
  repliedAt  DateTime?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User?     @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String?
  type       String
  subject    String
  details    String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reporter   User?    @relation(fields: [reporterId], references: [id])

  @@index([reporterId])
  @@index([status])
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  actorId   String?
  actorName String?
  metadata  String?
  type      String   @default("ACTIVITY")
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
}

model SupportTicket {
  id         String               @id @default(uuid())
  userId     String
  subject    String
  message    String
  priority   String               @default("MEDIUM")
  status     String               @default("OPEN")
  resolvedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id])
  replies    SupportTicketReply[]

  @@index([userId])
  @@index([status])
}

model SupportTicketReply {
  id        String        @id @default(uuid())
  ticketId  String
  userId    String
  message   String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

model CommunityPost {
  id            Int               @id @default(autoincrement())
  type          PostType
  title         String
  description   String
  category      CommunityCategory
  city          String
  neighbourhood String?
  rentalPeriod  String?
  budget        Float?
  tags          String[]
  status        PostStatus        @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  authorId      String
  savedCount    Int               @default(0)
  shares        Int               @default(0)
  views         Int               @default(0)
  isFeatured    Boolean           @default(false)
  comments      Comment[]
  author        User              @relation(fields: [authorId], references: [id])
  Conversation  Conversation[]
  likes         Like[]
  Match         Match[]
  media         Media[]
  OwnerReply    OwnerReply[]
  savedPosts    SavedPost[]
}

model Media {
  id        Int           @id @default(autoincrement())
  type      MediaType
  url       String
  thumbnail String?
  postId    Int
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id])
}

model Like {
  id        Int            @id @default(autoincrement())
  userId    String
  postId    Int?
  commentId Int?
  createdAt DateTime       @default(now())
  Comment   Comment?       @relation(fields: [commentId], references: [id])
  post      CommunityPost? @relation(fields: [postId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
}

model Comment {
  id        Int           @id @default(autoincrement())
  content   String
  authorId  String
  postId    Int
  createdAt DateTime      @default(now())
  author    User          @relation(fields: [authorId], references: [id])
  post      CommunityPost @relation(fields: [postId], references: [id])
  Like      Like[]
}

model SavedPost {
  id        Int           @id @default(autoincrement())
  userId    String
  postId    Int
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model Match {
  id            Int           @id @default(autoincrement())
  requestId     Int
  listingId     String
  createdAt     DateTime      @default(now())
  notified      Boolean       @default(false)
  listing       Listing       @relation(fields: [listingId], references: [id])
  CommunityPost CommunityPost @relation(fields: [requestId], references: [id])
}

model OwnerReply {
  id            Int            @id @default(autoincrement())
  requestId     Int
  ownerId       String
  type          OwnerReplyType
  payload       Json
  createdAt     DateTime       @default(now())
  User          User           @relation(fields: [ownerId], references: [id])
  CommunityPost CommunityPost  @relation(fields: [requestId], references: [id])
}

model AdvertisingRequest {
  id                 String    @id
  reference          String    @unique
  companyName        String
  contactPerson      String
  email              String
  phone              String
  businessCategory   String
  campaignType       String
  website            String?
  socialMedia        String?
  campaignGoal       String?
  campaignMessage    String
  preferredStartDate DateTime?
  preferredEndDate   DateTime?
  bannerUrl          String?
  termsAccepted      Boolean   @default(false)
  status             String    @default("PENDING")
  adminNote          String?
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime
  paymentProofUrl    String?
  paymentSubmittedAt DateTime?

  @@index([createdAt])
  @@index([status])
}

enum PostType {
  RENTAL_REQUEST
  COMMUNITY_FEED
  OWNER_ANNOUNCEMENT
  DISCUSSION
}

enum CommunityCategory {
  LOOKING_FOR_ITEM
  OFFERING_RENTAL
  EQUIPMENT_NEEDED
  EVENT_PLANNING
  BUSINESS_ANNOUNCEMENT
  RECOMMENDATION
  LOST_FOUND
  EMERGENCY_REQUEST
}

enum PostStatus {
  PENDING
  RESOLVED
  EXPIRED
  APPROVED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
  ATTACHMENT
}

enum OwnerReplyType {
  LISTING
  QUOTE
  DISCOUNT
  QUESTION
  RECOMMENDATION
  MULTIPLE_LISTINGS
}

enum NotificationType {
  COMMENT
  LIKE
  OWNER_REPLY
  MATCH_FOUND
  SIMILAR_POST
  REQUEST_EXPIRED
  REQUEST_RESOLVED
}

model HeroPromotion {
  id               String    @id @default(uuid())
  title            String
  description      String?
  heroImage        String    
  productService   String?
  cardImage        String    
  location         String?
  rating           String?
  originalPrice    Decimal?
  discountPercent  Int?
  discountedPrice  Decimal?
  ctaText          String?
  ctaLink          String?
  listingId        String?   // optional link back to the source Listing
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean   @default(true)
  displayOrder     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  specs            String?
}

model FeaturedListing {
  id               String    @id @default(uuid())
  listingId        String    @unique
  discountPercent  Int?
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean   @default(true)
  displayOrder     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  listing          Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
}
