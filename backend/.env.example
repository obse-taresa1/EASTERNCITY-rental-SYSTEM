# ==============================================================
#  BACKEND ENVIRONMENT VARIABLES — EASTERNCITY Rental System
# ==============================================================
#  Copy this file to .env and fill in your local values.
#  NEVER commit .env to version control.
# ==============================================================

# ── Server ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────
# PostgreSQL connection string (e.g. Neon, Supabase, or local)
DATABASE_URL=

# ── Cloudinary file storage ─────────────────────────────────────
# Create these in the Cloudinary dashboard. Keep API_SECRET on the backend only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Authentication ─────────────────────────────────────────────
# Strong random strings — change before deploying to production
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── CORS & Client ──────────────────────────────────────────────
# URL used in email links. CORS_ORIGIN accepts one or more comma-separated
# frontend origins; CLIENT_ORIGIN is supported for backward compatibility.
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://easterncity-rental-system.vercel.app

# ── Email / SMTP ───────────────────────────────────────────────
# Preferred for local and Render Free deployments: Brevo HTTPS API.
BREVO_API_KEY=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=
MAIL_FROM=EasternCity <no-reply@easterncity.com>

# ── Seeding ────────────────────────────────────────────────────
# Used only when running: npx prisma db seed
SEED_SUPER_ADMIN_EMAIL=superadmin@example.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

# ── Uploads Cleanup ────────────────────────────────────────────
# Number of days before uploaded files are cleaned up
UPLOAD_CLEANUP_DAYS=7

# AI assistant (server-side only; never add this to frontend/.env)
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash when omitted.
GEMINI_MODEL=gemini-2.5-flash
